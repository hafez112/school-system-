APP_NAME=School System
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=school_system
DB_USERNAME=school
DB_PASSWORD=school_secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=school_system
MYSQL_USER=school
MYSQL_PASSWORD=school_secret
